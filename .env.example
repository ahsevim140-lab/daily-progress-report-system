# Copy this file to .env.local and replace the two values below.
# Supabase Dashboard -> Connect (or Settings -> API Keys)
# Use the public/publishable key, NOT a secret/service_role key.

VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-SUPABASE-PUBLISHABLE-KEY"

# This build is an offline model: with VITE_OFFLINE_MODE unset or "true" the app uses the in-browser
# mock and shows an OFFLINE banner. Real-Supabase mode is not kept in step yet (see README).
